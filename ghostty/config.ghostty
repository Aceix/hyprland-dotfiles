# Ghostty equivalent of ~/.config/kitty/kitty.conf. Ghostty only reads
# ~/.config/ghostty/config.ghostty. Reload with ctrl+shift+, or
#   gdbus call --session --dest com.mitchellh.ghostty \
#     --object-path /com/mitchellh/ghostty \
#     --method org.gtk.Actions.Activate reload-config '[]' '{}'

# --- Window & appearance -----------------------------------------------------
# kitty: background_opacity 1.00 + dynamic_background_opacity yes.
# The live value is in overrides/opacity (included at the bottom), which
# Neovim rewrites and then asks Ghostty to reload, standing in for
# `kitty @ set-background-opacity` (see ~/.config/nvim/lua/configs/transparency.lua).
background-opacity = 1.00
# keep coloured cells (Neovim's opaque look) solid even when the window is translucent
background-opacity-cells = false

# --- Cursor trail (kitty: cursor_trail 1) ------------------------------------
# Ghostty has no built-in trail; this GLSL shader draws one using the cursor colour.
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always

# --- Remote control (kitty: allow_remote_control / listen_on) ----------------
# Nothing to configure: Ghostty runs single-instance and exposes
# org.gtk.Actions (reload-config, new-window, ...) on the session bus.

# --- Keys passed to the program as escape sequences --------------------------
# kitty: map ctrl+tab send_text ... \x1b[9;5u  (csi: omits the leading \x1b[)
# These override Ghostty's default next_tab / previous_tab on ctrl(+shift)+tab.
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
keybind = ctrl+shift+grave_accent=csi:96;6u

# --- Includes (kitty: include ...) -------------------------------------------
# themes/noctalia is generated by Noctalia alongside kitty/themes/noctalia.conf
theme = noctalia
config-file = vscode-keys.ghostty
# must stay last so its background-opacity wins; `?` makes it optional
config-file = ?overrides/opacity
